{
  "manifest_version": 3,
  "name": "WebChat",
  "version": "2.0.0",
  "key": "",
  "description": "基于当前网页内容的AI增强问答系统",
  "permissions": ["activeTab", "tabs", "scripting", "storage", "downloads", "contextMenus", "sidePanel"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/marked.min.js", "content.js"],
      "css": ["styles/panel.css", "styles/recorder.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/marked.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
